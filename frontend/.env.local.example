# ---------------------------------------------------------------------------
# Supabase - Project Settings -> Data API / API Keys   (https://supabase.com)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_...) - safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Secret key (sb_secret_...) - server only, never commit
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Synthetic login-email domain for admin-created clients
NEXT_PUBLIC_CLIENT_EMAIL_DOMAIN=clients.studioflow.app

# AES-256-GCM key for encrypting handoff credentials.  openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Bootstrap admin - used once by: npm run create-admin
ADMIN_EMAIL=admin@studioflow.app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Google Calendar  (see README section 9 for how to create these)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Leave blank in development - it defaults to <your origin>/api/calendar/callback
GOOGLE_REDIRECT_URI=

# Timezone the studio works in, e.g. Asia/Riyadh. Events are written in this zone.
STUDIO_TIMEZONE=Asia/Riyadh
